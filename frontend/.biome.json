{
	"$schema": "https://biomejs.dev/schemas/1.8.0/schema.json",
	"formatter": {
		"enabled": true,
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"style": {
				"useConst": "off"
			}
		}
	},
	"files": {
		"ignore": ["dist/", "node_modules/", ".vite/", "coverage/", "tmp/", ".tmp/"]
	}
}
