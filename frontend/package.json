{
	"name": "zview-frontend",
	"version": "0.1.0",
	"private": true,
	"description": "Frontend tooling scaffold for zview (pnpm + lint/format stubs)",
	"type": "module",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"dev": "node ./scripts/dev-placeholder.mjs",
		"build": "node ./scripts/build-placeholder.mjs",
		"lint": "biome lint .",
		"fmt": "biome check .",
		"fmt:write": "biome format --write .",
		"test": "node ./scripts/test-placeholder.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.13",
		"typescript": "5.9.3"
	}
}
