{
	"name": "zview-frontend",
	"version": "0.1.0",
	"private": true,
	"description": "Web UI for zview (Vite + TypeScript)",
	"type": "module",
	"engines": {
		"node": ">=22.0.0"
	},
	"packageManager": "pnpm@10.19.0",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"fmt": "biome format .",
		"fmt:write": "biome format --write .",
		"check": "tsc --noEmit",
		"test": "vitest run",
		"fixtures:e2e": "node scripts/generate-test-pdfs.mjs",
		"test:e2e:debug": "PW_LOG_SERVER=1 DEBUG=pw:server,pw:browser npx playwright test"
	},
	"dependencies": {
		"@fontsource-variable/noto-sans-jp": "^5.2.10",
		"@fontsource-variable/space-grotesk": "^5.2.10",
		"pdfjs-dist": "^5.4.530",
		"react": "18.3.1",
		"react-dom": "18.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.13",
		"@playwright/test": "^1.58.1",
		"@tailwindcss/vite": "4.1.8",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^25.2.0",
		"@types/react": "18.3.11",
		"@types/react-dom": "18.3.1",
		"@vitejs/plugin-react": "4.3.3",
		"happy-dom": "^20.5.0",
		"pdf-lib": "^1.17.1",
		"tailwindcss": "4.1.8",
		"typescript": "5.9.3",
		"vite": "5.4.10",
		"vitest": "^4.0.18"
	}
}
